{
  "expo": {
    "name": "Primeiro Olhar",
    "slug": "primeiro-olhar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.app.primeiroolhar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "primeiroolhar",
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Primeiro Olhar acesse a câmera para filmar a criança."
        }
      ],
      "expo-image-picker",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 34
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd6ab4ca-9563-4707-8964-cfb0ff11fd7b"
      }
    }
  }
}
